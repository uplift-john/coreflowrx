{
  "name": "coreflow-rx",
  "version": "1.0.0",
  "description": "CoreFlow Specialty Infusion marketing site, built with Eleventy.",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "check-links": "node scripts/check-links.mjs",
    "check-pdf": "python3 scripts/check-pdf-geometry.py _site/coreflow-fax-cover-sheet.pdf",
    "verify": "eleventy && node scripts/check-links.mjs && python3 scripts/check-pdf-geometry.py _site/coreflow-fax-cover-sheet.pdf",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "wrangler": "^4.110.0"
  }
}
