<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="canonical" href="{{ (site.url + page.url) | replace('.html', '') }}">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="favicon.svg">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ (site.url + page.url) | replace('.html', '') }}">
<meta property="og:image" content="{{ site.ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.ogImage }}">
<style>
 body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:#1a1a1a;background:#fff;line-height:1.6}
 .skip-link{position:absolute;left:-10000px;top:0;background:#175868;color:#fff;padding:.75rem 1rem;z-index:1000;text-decoration:none}.skip-link:focus{left:8px;top:8px}
 .container{max-width:1180px;margin:0 auto;padding:0 1rem}
 .site-header{border-bottom:1px solid #d8dee8;background:#fff;position:sticky;top:0;z-index:50}
 .site-header__inner{display:flex;align-items:center;justify-content:space-between;padding:.75rem 0;gap:1rem}
 .brand{display:inline-flex;align-items:center;gap:.5rem;font-weight:700;color:#175868;text-decoration:none;font-size:1.125rem}
 .brand__mark{height:48px;width:auto}
 .hero{padding:3rem 0;background:linear-gradient(180deg,#f5f7fa 0,#fff 100%)}
 .hero h1{font-size:2.25rem;line-height:1.15;color:#175868;margin:0 0 1rem}
</style>
<link rel="stylesheet" href="styles.css">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":["MedicalBusiness","Pharmacy"],"name":"{{ site.name }}","url":"{{ (site.url + page.url) | replace('.html', '') }}","telephone":"{{ site.phone }}","faxNumber":"{{ site.fax }}","email":"{{ site.email }}","address":{"@type":"PostalAddress","streetAddress":"{{ site.address.street }}","addressLocality":"{{ site.address.city }}","addressRegion":"{{ site.address.state }}","postalCode":"{{ site.address.zip }}","addressCountry":"US"},"areaServed":{"@type":"State","name":"South Carolina"},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"08:30","closes":"16:30"}]}
</script>
<!-- Privacy-friendly analytics by Plausible. The bootstrap lives in site.js,
     NOT inline: the planned enforcing CSP is script-src 'self' https://plausible.io
     with no 'unsafe-inline', and an inline bootstrap would be blocked. -->
<script async src="https://plausible.io/js/pa-egVEd85UQF5ji98mPTW2a.js"></script>
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header class="site-header">
 <div class="container site-header__inner">
 <a class="brand" href="index.html" aria-label="{{ site.name }} home page"{% if activeNav == "home" %} aria-current="page"{% endif %}><img class="brand__mark" src="{{ site.logo }}" alt="{{ site.name }}" width="{{ site.logoWidth }}" height="{{ site.logoHeight }}"></a>
 {#- Contact values come from _data/site.json only. Never hardcode them here.
     Phone is tel:, fax is deliberately plain text (a fax number must never be
     dialled as a voice call), email is mailto:. Below 768px only the phone
     survives in the bar; fax and email stay in the footer and on /contact. -#}
 <ul class="header-contact" aria-label="How to reach CoreFlow">
 <li class="header-contact__item header-contact__item--phone">
 <a class="header-contact__link" href="tel:{{ site.phoneTel }}">
 <svg class="header-contact__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.82-1.31a2 2 0 0 1 2.11-.45c.74.34 1.53.57 2.34.7A2 2 0 0 1 22 16.92z"></path></svg>
 <span class="header-contact__label">Call</span>
 <span class="header-contact__value">{{ site.phone }}</span>
 </a>
 </li>
 <li class="header-contact__item header-contact__item--fax">
 <span class="header-contact__link">
 <svg class="header-contact__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"></path><rect x="2" y="9" width="20" height="9" rx="2"></rect><path d="M6 14h12v8H6z"></path></svg>
 <span class="header-contact__label">Fax</span>
 <span class="header-contact__value">{{ site.fax }}</span>
 </span>
 </li>
 <li class="header-contact__item header-contact__item--email">
 <a class="header-contact__link" href="mailto:{{ site.email }}">
 <svg class="header-contact__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m2 7 10 6 10-6"></path></svg>
 <span class="header-contact__label">Email</span>
 <span class="header-contact__value">{{ site.email }}</span>
 </a>
 </li>
 </ul>
 <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu"><span class="nav-toggle__icon" aria-hidden="true"></span></button>
 <nav class="primary-nav" id="primary-nav" aria-label="Primary">
 <ul class="primary-nav__list">
 <li><a href="providers.html"{% if activeNav == "providers" %} aria-current="page"{% endif %}>For Prescribers</a></li>
 <li><a href="diseases-we-treat.html"{% if activeNav == "diseases" %} aria-current="page"{% endif %}>Diseases We Treat</a></li>
 <li><a href="drugs-we-provide.html"{% if activeNav == "drugs" %} aria-current="page"{% endif %}>Drugs We Provide</a></li>
 <li><a href="patients.html"{% if activeNav == "patients" %} aria-current="page"{% endif %}>For Patients</a></li>
 <li><a href="about.html"{% if activeNav == "about" %} aria-current="page"{% endif %}>About</a></li>
 <li><a href="contact.html"{% if activeNav == "contact" %} aria-current="page"{% endif %}>Contact</a></li>
 <li class="primary-nav__cta"><a class="btn btn--primary" href="refer.html"{% if activeNav == "refer" %} aria-current="page"{% endif %}>Refer a Patient →</a></li>
 </ul>
 </nav>
 </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
 <div class="container">
 <div class="site-footer__grid">
 <div>
 <h2 style="font-size:1.125rem">{{ site.name }}</h2>
 <address>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}<br><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a> · Fax {{ site.fax }}<br><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>{{ site.hours }}</address>
 </div>
 <nav aria-label="Prescribers"><h3 style="font-size:1rem">Prescribers</h3><ul><li><a href="refer.html">Refer a Patient</a></li><li><a href="providers.html">For Prescribers</a></li><li><a href="diseases-we-treat.html">Diseases We Treat</a></li><li><a href="drugs-we-provide.html">Drugs We Provide</a></li><li><a href="payers.html">For Payers &amp; Health Plans</a></li></ul></nav>
 <nav aria-label="Patients"><h3 style="font-size:1rem">Patients</h3><ul><li><a href="patients.html">For Patients &amp; Caregivers</a></li><li><a href="contact.html">Contact</a></li></ul></nav>
 <nav aria-label="Company"><h3 style="font-size:1rem">Company</h3><ul><li><a href="about.html">About</a></li><li><a href="careers.html">Careers</a></li><li><a href="contact.html">Contact</a></li></ul></nav>
 <nav aria-label="Legal"><h3 style="font-size:1rem">Legal</h3><ul><li><a href="privacy.html">Privacy Policy</a></li><li><a href="terms.html">Terms &amp; Conditions</a></li><li><a href="notice-of-privacy-practices.html">Notice of Privacy Practices</a></li><li><a href="non-discrimination.html">Non-Discrimination</a></li><li><a href="accessibility.html">Accessibility</a></li></ul></nav>
 </div>
 <p class="site-footer__legal">© 2026 {{ site.name }}. All rights reserved.<br>{{ site.legalLine }}</p>
 </div>
</footer>
<script src="site.js" defer></script>
{% if pageScript %}<script src="{{ pageScript }}" defer></script>{% endif %}
</body>
</html>
